{
	"$schema": "https://schemas.wp.org/wp/6.9/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "770px",
			"wideSize": "1170px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "slug": "encre", "name": "Encre (texte)", "color": "#272b2e" },
				{ "slug": "blanc", "name": "Blanc", "color": "#ffffff" },
				{ "slug": "sable", "name": "Sable (en-tête)", "color": "#efece5" },
				{ "slug": "sable-clair", "name": "Sable clair (encadrés)", "color": "#f1eee7" },
				{ "slug": "lin", "name": "Lin (bordures)", "color": "#e0dacb" },
				{ "slug": "nuit", "name": "Nuit (menu)", "color": "#1e1f21" },
				{ "slug": "anthracite", "name": "Anthracite (pied de page)", "color": "#232629" },
				{ "slug": "ardoise", "name": "Ardoise", "color": "#2a2e31" },
				{ "slug": "gris", "name": "Gris (texte secondaire)", "color": "#797f85" },
				{ "slug": "taupe", "name": "Taupe (boutons)", "color": "#868279" },
				{ "slug": "framboise", "name": "Framboise (survol)", "color": "#cc4670" },
				{ "slug": "rose", "name": "Rose (page active)", "color": "#f1c4c4" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": false,
			"fontFamilies": [
				{ "slug": "lato", "name": "Lato", "fontFamily": "Lato, 'Helvetica Neue', Arial, sans-serif" },
				{ "slug": "prata", "name": "Prata", "fontFamily": "Prata, Georgia, 'Times New Roman', serif" }
			],
			"fontSizes": [
				{ "slug": "small", "name": "Petit", "size": "16px" },
				{ "slug": "medium", "name": "Normal", "size": "18px" },
				{ "slug": "large", "name": "Grand", "size": "22px" },
				{ "slug": "x-large", "name": "Très grand", "size": "32px" },
				{ "slug": "xx-large", "name": "Titre", "size": "38px" }
			]
		},
		"spacing": {
			"units": [ "px", "em", "rem", "%", "vh", "vw" ]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--blanc)",
			"text": "var(--wp--preset--color--encre)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--lato)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"fontWeight": "300",
			"lineHeight": "1.667"
		},
		"spacing": {
			"blockGap": "1.2em",
			"padding": { "left": "20px", "right": "20px" }
		},
		"elements": {
			"link": {
				"color": { "text": "inherit" },
				"typography": { "textDecoration": "none", "fontWeight": "400" },
				":hover": { "color": { "text": "var(--wp--preset--color--framboise)" } }
			},
			"heading": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--prata)", "fontWeight": "400" },
				"color": { "text": "var(--wp--preset--color--encre)" }
			},
			"h1": { "typography": { "fontSize": "38px", "lineHeight": "1.37" } },
			"h2": { "typography": { "fontSize": "32px", "lineHeight": "1.375" } },
			"h3": { "typography": { "fontSize": "26px", "lineHeight": "1.4" } },
			"h4": { "typography": { "fontSize": "22px", "lineHeight": "1.4" } },
			"h5": { "typography": { "fontSize": "18px", "lineHeight": "1.5" } },
			"h6": { "typography": { "fontSize": "16px", "lineHeight": "1.5" } },
			"button": {
				"color": { "background": "var(--wp--preset--color--taupe)", "text": "var(--wp--preset--color--blanc)" },
				"border": { "radius": "0", "width": "1px", "style": "solid", "color": "var(--wp--preset--color--taupe)" },
				"typography": { "fontFamily": "var(--wp--preset--font-family--lato)", "fontSize": "12px", "fontWeight": "400", "letterSpacing": ".1em", "textTransform": "uppercase", "lineHeight": "46px" },
				"spacing": { "padding": { "top": "0", "bottom": "0", "left": "27px", "right": "27px" } },
				":hover": { "color": { "background": "var(--wp--preset--color--blanc)", "text": "var(--wp--preset--color--taupe)" } }
			}
		},
		"blocks": {
			"core/navigation": {
				"typography": { "fontSize": "18px", "fontWeight": "400" }
			},
			"core/post-title": {
				"elements": { "link": { "typography": { "fontWeight": "400" } } }
			},
			"core/separator": {
				"color": { "text": "var(--wp--preset--color--lin)" }
			},
			"core/table": {
				"typography": { "fontSize": "var(--wp--preset--font-size--medium)" }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "En-tête", "area": "header" },
		{ "name": "footer", "title": "Pied de page", "area": "footer" }
	],
	"customTemplates": [
		{ "name": "page-pleine-largeur", "title": "Page pleine largeur (sans bandeau)", "postTypes": [ "page" ] }
	]
}
